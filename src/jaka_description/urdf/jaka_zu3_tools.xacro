<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="jaka_zu3_camera" params="parent use_gazebo:=false enable_camera_sensor:=true">
    <material name="tool_dark">
      <color rgba="0.12 0.14 0.16 1"/>
    </material>
    <link name="camera_link">
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00006"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="tool_dark"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.090 0.030"/>
        </geometry>
      </collision>
    </link>

    <!-- Keep the housing clear of the ground at the zero pose. Gazebo depth
         cameras look along local +X; rotate it to look along tool +Z. -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="0 -0.05 -0.02" rpy="-1.57079632679 -1.57079632679 0"/>
    </joint>
    
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <xacro:if value="${use_gazebo and enable_camera_sensor}">
      <gazebo reference="camera_link">
        <!-- Keep both aligned image streams inexpensive enough for ros2_control. -->
        <sensor name="wrist_depth_camera" type="depth_camera">
          <pose>0.02 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>wrist_camera/depth_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>128</width>
              <height>96</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
        <sensor name="wrist_rgb_camera" type="camera">
          <pose>0.014 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>wrist_camera/rgb_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>128</width>
              <height>96</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="jaka_zu3_parallel_gripper" params="parent use_gazebo:=false">
    <material name="gripper_black">
      <color rgba="0.08 0.08 0.08 1"/>
    </material>
    <material name="finger_red">
      <color rgba="0.65 0.12 0.08 1"/>
    </material>
    <link name="gripper_base_link">
      <inertial>
        <mass value="0.12"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.06 0.06 0.035"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.06 0.06 0.03"/>
        </geometry>
      </collision>
    </link>
    <joint name="gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0.02" rpy="0 0 1.5708"/>
    </joint>
    <link name="left_finger_link">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.06 0.01 0.04"/>
        </geometry>
        <material name="finger_red"/>
      </visual>
      <!-- The visual finger reaches the ground when gripper_base_link is at
           z=0.06. Inset the collision by 2 mm at each end so Gazebo ground
           friction cannot pin the prismatic joint during lateral closing. -->
      <collision>
        <geometry>
          <box size="0.06 0.01 0.036"/>
        </geometry>
      </collision>
    </link>
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <!-- Both simulated joints receive the same position trajectory. The
           legacy Gazebo mimic follower can lag when a finger makes contact. -->
      <!-- At zero travel the inner faces are 40 mm apart, enough to clear
           the 20 mm target. Positive travel closes both fingers inward. -->
      <origin xyz="0 0.025 0.04" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <!-- Keep the commanded open position (0) inside the physics limits.
           Starting exactly on the hard stop pins the first close in this
           Gazebo setup. Use the same interior open pose for every transfer.
           This 1 mm margin is not part of the commanded finger stroke. -->
      <limit lower="-0.001" upper="0.011" effort="20" velocity="0.2"/>
    </joint>
    <link name="right_finger_link">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.06 0.01 0.04"/>
        </geometry>
        <material name="finger_red"/>
      </visual>
      <!-- Match the left finger's 2 mm ground-contact clearance. -->
      <collision>
        <geometry>
          <box size="0.06 0.01 0.036"/>
        </geometry>
      </collision>
    </link>
    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0 -0.025 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Same hard-stop margin as the left joint; open commands remain 0. -->
      <limit lower="-0.001" upper="0.011" effort="20" velocity="0.2"/>
    </joint>
    <link name="gripper_tcp"/>
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="gripper_tcp"/>
      <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    </joint>
    <gazebo reference="left_finger_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>
    <gazebo reference="right_finger_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>
  </xacro:macro>
</robot>
