<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="jaka_zu3_camera" params="parent use_gazebo:=false enable_camera_sensor:=true">
    <material name="tool_dark">
      <color rgba="0.12 0.14 0.16 1"/>
    </material>
    <link name="camera_link">
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00006"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="tool_dark"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.090 0.030"/>
        </geometry>
      </collision>
    </link>

    <!-- Keep the housing clear of the ground at the zero pose. Gazebo depth
         cameras look along local +X; rotate it to look along tool +Z. -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="0 0 0.015" rpy="-1.57079632679 -1.57079632679 0"/>
    </joint>
    
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <xacro:if value="${use_gazebo and enable_camera_sensor}">
      <gazebo reference="camera_link">
        <!-- Keep both aligned image streams inexpensive enough for ros2_control. -->
        <sensor name="wrist_depth_camera" type="depth_camera">
          <pose>0.02 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>wrist_camera/depth_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>128</width>
              <height>96</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
        <sensor name="wrist_rgb_camera" type="camera">
          <pose>0.014 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>wrist_camera/rgb_image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>128</width>
              <height>96</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
